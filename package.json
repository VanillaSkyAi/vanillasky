{
  "name": "vanillasky",
  "version": "0.0.0",
  "description": "A complete, open-source video chat application.",
  "keywords": [
    "video-chat",
    "voice-chat",
    "ai-chat",
    "generative-video",
    "video-response",
    "ai-output",
    "streaming",
    "react",
    "llm",
    "video"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanillaSkyAi/video.git"
  },
  "bugs": {
    "url": "https://github.com/VanillaSkyAi/video/issues"
  },
  "homepage": "https://vanillasky.ai",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:functions": "wrangler pages functions build functions --outdir .generated/functions-build --project-directory . --build-output-directory dist",
    "verify:app-build": "node scripts/verify-app-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "tsx --test tests/app-api/*.test.mjs",
    "browser:install": "playwright install chromium firefox webkit",
    "browser:test": "playwright test",
    "test:app": "playwright test --config app.playwright.config.ts",
    "acceptance:chat": "tsx scripts/acceptance/run.ts",
    "verify": "npm run check && npm run check:docs && npm run acceptance:chat && npm run build && npm run build:functions && npm run verify:app-build && npm run verify:preview && npm run test:app",
    "verify:preview": "node scripts/verify-app-preview.mjs",
    "check:unused": "knip",
    "check": "npm run lint && npm run typecheck && npm run check:unused && npm test && npm run test:api",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "knip": "6.35.0",
    "miniflare": "5.20260820.0-alpha",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "private": true,
  "dependencies": {
    "jose": "6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
