{
  "name": "@vanillaskyai/video",
  "version": "0.8.8",
  "description": "Open-source voice-and-video chat SDK for AI applications.",
  "keywords": [
    "video-chat",
    "voice-chat",
    "ai-chat",
    "generative-video",
    "video-response",
    "ai-output",
    "streaming",
    "react",
    "llm",
    "video"
  ],
  "type": "module",
  "sideEffects": [
    "./styles/video-chat.css"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanillaSkyAi/video.git"
  },
  "bugs": {
    "url": "https://github.com/VanillaSkyAi/video/issues"
  },
  "homepage": "https://vanillasky.ai",
  "files": [
    "bin",
    "dist",
    "styles/video-chat.css",
    "starters/video-chat/.env.example",
    "starters/video-chat/README.md",
    "starters/video-chat/index.html",
    "starters/video-chat/package.json",
    "starters/video-chat/server.ts",
    "starters/video-chat/providers.ts",
    "starters/video-chat/providers/speech.ts",
    "starters/video-chat/providers/video.ts",
    "starters/video-chat/src/main.tsx",
    "starters/video-chat/stock.ts",
    "starters/video-chat/tsconfig.json",
    "starters/video-chat/vite.config.ts",
    "registry/items",
    "examples/custom-template",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "PUBLIC-API.md",
    "docs/reference/provider-adapters.md",
    "docs/reference/protocol.md",
    "CHANGELOG.md",
    "docs/*.md",
    "docs/reference"
  ],
  "bin": {
    "vanillasky": "bin/vanillasky.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js",
      "default": "./dist/templates.js"
    },
    "./templates/catalog": {
      "types": "./dist/template-catalog.d.ts",
      "import": "./dist/template-catalog.js",
      "default": "./dist/template-catalog.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js",
      "default": "./dist/test.js"
    },
    "./video-chat.css": "./styles/video-chat.css"
  },
  "scripts": {
    "browser:install": "playwright install chromium firefox webkit",
    "browser:test": "playwright test",
    "build": "tsup",
    "lint": "eslint .",
    "catalog:sync": "tsx scripts/generate-builtin-catalog.ts",
    "catalog:check": "tsx scripts/generate-builtin-catalog.ts --check",
    "registry:sync": "npm run catalog:sync && node scripts/sync-template-registry.mjs",
    "registry:check": "node scripts/sync-template-registry.mjs --check && npm run catalog:check",
    "template:check": "tsx scripts/template-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:nextjs": "node scripts/verify-nextjs-onboarding.mjs",
    "verify:published": "node scripts/verify-published-package.mjs",
    "verify:package-size": "tsx scripts/verify-package-size.ts",
    "verify:api": "npm run build && node scripts/verify-public-api-surface.mjs",
    "verify:package": "npm run build && node scripts/verify-packed-package.mjs",
    "release:build": "node scripts/release-build.mjs",
    "acceptance:chat": "tsx scripts/acceptance/run.ts"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "tsx": ">=4.19 <5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "es-module-lexer": "^1.7.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
