# Copy to .dev.vars. Keep keys server-side; never use VITE_ variables for them.
# Start with real AI planning and fal-generated video.
# wrangler.jsonc already enables fal; no extra local flag is needed.
ANTHROPIC_API_KEY=
FAL_KEY=

# Optional generated voice. Without it, speech uses the browser.
XAI_API_KEY=

# Optional stock alternative; used when generated video is not configured.
# Public viewers can also use it after their personal AI-video allowance expires.
PEXELS_API_KEY=

# npm run dev supplies a persistent local-only quota salt and local D1 database.
# Production deployment keeps its own existing salt, database and access rules.
