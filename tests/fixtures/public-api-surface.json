{
  "@vanillaskyai/video": {
    "source": "src/index.ts",
    "declaration": "dist/index.d.ts",
    "runtime": "dist/index.js",
    "environment": "universal",
    "runtimeExports": [
      "VideoValidationError",
      "getSceneDuration",
      "getSceneDurationBounds",
      "getSpokenDuration",
      "getVideoDuration",
      "parseVideo"
    ],
    "typeExports": [
      "SceneDurationBounds",
      "Video",
      "VideoAudio",
      "VideoNarrationGroup",
      "VideoOrientation",
      "VideoScene",
      "VideoStatus",
      "VideoStyle",
      "VideoStyleOptions",
      "VideoValidationError",
      "VideoValidationErrorCode"
    ]
  },
  "@vanillaskyai/video/server": {
    "source": "src/server.ts",
    "declaration": "dist/server.d.ts",
    "runtime": "dist/server.js",
    "environment": "server",
    "runtimeExports": [
      "createVideoChatHandler"
    ],
    "typeExports": [
      "VideoFinishReason",
      "VideoGenerationSummary",
      "VideoChatCapabilities",
      "VideoChatConversationTurn",
      "VideoChatHandlerOptions",
      "VideoChatMode",
      "VideoChatWelcomeOptions",
      "VideoChatWelcomePrompt",
      "VideoProviderUsage",
      "VideoWarning",
      "VideoWarningCategory"
    ]
  },
  "@vanillaskyai/video/react": {
    "source": "src/react.ts",
    "declaration": "dist/react.d.ts",
    "runtime": "dist/react.js",
    "environment": "browser",
    "runtimeExports": [
      "VideoChat",
      "VideoError",
      "VideoPlayer",
      "createVideoChatVoice",
      "useVideoChat"
    ],
    "typeExports": [
      "CreateVideoChatVoiceOptions",
      "UseVideoChatOptions",
      "UseVideoChatResult",
      "VideoChatAskOptions",
      "VideoChatCapabilities",
      "VideoChatFirstFrameMetric",
      "VideoChatPlaybackMetric",
      "VideoChatProps",
      "VideoChatMedia",
      "VideoChatMode",
      "VideoChatPreparedSpeech",
      "VideoChatStatus",
      "VideoChatSuggestion",
      "VideoChatTurn",
      "VideoChatVoice",
      "VideoChatWelcome",
      "VideoError",
      "VideoErrorOptions",
      "VideoPlaybackMode",
      "VideoPlayerProps"
    ]
  },
  "@vanillaskyai/video/test": {
    "source": "src/test.ts",
    "declaration": "dist/test.d.ts",
    "runtime": "dist/test.js",
    "environment": "test",
    "runtimeExports": [
      "createMockVideoPlanner",
      "simulateVideoStream",
